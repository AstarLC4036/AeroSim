#pragma kernel DrawMFD

RWTexture2D<float4> _Result;
uint _Width;
uint _Height;

// Draw commands
struct DrawCommand
{
    int type;           // 0=Line, 1=DashedLine, 2=Circle, 3=RectOutline, 4=RectFill, 5=Texture
    float4 param1;      // x0,y0,x1,y1 or cx,cy,radius,thickness
    float4 param2;      // Extra parameters (rect width/height, texture region, etc.)
    float4 color;
    int dashLength;
    int gapLength;
    int layer;
};

StructuredBuffer<DrawCommand> _Commands;
int _CommandCount;

// Texture drawing
Texture2D<float4> _SourceTex;
SamplerState sampler_SourceTex;

// Font atlas (TMP SDF). _FontAtlasChannel: 0 = alpha (Alpha8 atlas), 1 = red (R8 atlas)
// Sampling uses Load, so no sampler_FontAtlas is needed
Texture2D<float4> _FontAtlas;
int _FontAtlasChannel;

// Helper functions
float DistanceToLine(float2 p, float2 a, float2 b)
{
    float2 ab = b - a;
    float2 ap = p - a;
    float t = clamp(dot(ap, ab) / max(dot(ab, ab), 0.0001), 0.0, 1.0);
    float2 closest = a + t * ab;
    return length(p - closest);
}

float RectSDF(float2 p, float2 center, float2 halfSize)
{
    float2 d = abs(p - center) - halfSize;
    return length(max(d, 0.0)) + min(max(d.x, d.y), 0.0);
}

float CircleRingSDF(float2 p, float2 center, float radius, float thickness)
{
    return abs(length(p - center) - radius) - thickness * 0.5;
}

[numthreads(8,8,1)]
void DrawMFD (uint3 id : SV_DispatchThreadID)
{
    if (id.x >= _Width || id.y >= _Height) return;

    float2 pixelPos = float2(id.x, id.y) + 0.5;  // Pixel centre
    float4 finalColor = float4(0, 0, 0, 0);

    // Clip rectangle state: set by type 9, cleared by type 10; all later commands only take effect inside the rectangle (scissor)
    float2 clipMin = float2(0.0, 0.0);
    float2 clipMax = float2(_Width, _Height);

    for (int cmdIndex = 0; cmdIndex < _CommandCount; cmdIndex++)
    {
        DrawCommand cmd = _Commands[cmdIndex];

        if (cmd.type == 9)                       // SetClipRect（param1 = min/max）
        {
            clipMin = min(cmd.param1.xy, cmd.param1.zw);
            clipMax = max(cmd.param1.xy, cmd.param1.zw);
            continue;
        }
        if (cmd.type == 10)                      // ClearClip
        {
            clipMin = float2(0.0, 0.0);
            clipMax = float2(_Width, _Height);
            continue;
        }

        float4 cmdColor = cmd.color;

        // ---- Bounding-box rejection: skip pixels outside the command's range outright (saves the SDF and atlas sampling; crucial with lots of text) ----
        float2 bMin, bMax;
        if (cmd.type == 0 || cmd.type == 1)          // Line / DashedLine
        {
            float pad = 2.0 + max(cmd.param2.x, 0.0) * 0.5;   // + half the line width (param2.x is always 0 for type 1)
            bMin = min(cmd.param1.xy, cmd.param1.zw) - pad;
            bMax = max(cmd.param1.xy, cmd.param1.zw) + pad;
        }
        else if (cmd.type == 2)                      // Circle
        {
            float rr = cmd.param1.z + cmd.param1.w * 0.5 + 2.0;
            bMin = cmd.param1.xy - rr;
            bMax = cmd.param1.xy + rr;
        }
        else if (cmd.type == 3)                      // RectOutline
        {
            float2 e = cmd.param1.zw + cmd.param2.x * 0.5 + 2.0;
            bMin = cmd.param1.xy - e;
            bMax = cmd.param1.xy + e;
        }
        else if (cmd.type == 4)                      // RectFill (param1 = centre + half size)
        {
            bMin = cmd.param1.xy - cmd.param1.zw;
            bMax = cmd.param1.xy + cmd.param1.zw;
        }
        else if (cmd.type == 7)                      // Disc (param1 = centre + radius)
        {
            float rr = max(cmd.param1.z, 0.0) + 2.0;
            bMin = cmd.param1.xy - rr;
            bMax = cmd.param1.xy + rr;
        }
        else if (cmd.type == 8)                      // RotatedRectFill (param1 = centre + half size; param2.xy = cos/sin)
        {
            float2 cc = cmd.param2.xy;
            float2 ax = float2(cc.x, cc.y) * cmd.param1.z;
            float2 ay = float2(-cc.y, cc.x) * cmd.param1.w;
            float2 e = abs(ax) + abs(ay) + 1.0;
            bMin = cmd.param1.xy - e;
            bMax = cmd.param1.xy + e;
        }
        else if (cmd.type == 11)                     // Arc (param1 = centre + radius + thickness; param2.xy = start/end angle in degrees)
        {
            float rr = max(cmd.param1.z, 0.0) + max(cmd.param1.w, 0.0) * 0.5 + 2.0;
            bMin = cmd.param1.xy - rr;
            bMax = cmd.param1.xy + rr;
        }
        else if (cmd.type == 12)                     // Triangle (param1.xy / param1.zw / param2.xy = the three vertices)
        {
            float2 t0 = cmd.param1.xy;
            float2 t1 = cmd.param1.zw;
            float2 t2 = cmd.param2.xy;
            bMin = min(min(t0, t1), t2) - 2.0;
            bMax = max(max(t0, t1), t2) + 2.0;
        }
        else                                         // Texture / Text: param1 is itself min/max
        {
            bMin = cmd.param1.xy;
            bMax = cmd.param1.zw;
        }

        // Only 3/4/5 mean "take effect outside the shape"; every other layer value (including any mistyped int) is treated as 0 = plain coverage,
        // so the old call sites where `layer` was never used do not suddenly gain semantics from this change.
        bool outsideShape = (cmd.layer == 3 || cmd.layer == 4 || cmd.layer == 5);
        if (!outsideShape &&
            (pixelPos.x < bMin.x || pixelPos.x > bMax.x ||
             pixelPos.y < bMin.y || pixelPos.y > bMax.y)) continue;

        // The clip rectangle applies to every command (including EraseOutside)
        if (pixelPos.x < clipMin.x || pixelPos.x > clipMax.x ||
            pixelPos.y < clipMin.y || pixelPos.y > clipMax.y) continue;

        float alpha = 0.0;
        float dist = 1e10;

        switch (cmd.type)
        {
            case 0: // Line (param2.x = line width in pixels; <=1 keeps the original 1px look)
            {
                float2 a = cmd.param1.xy;
                float2 b = cmd.param1.zw;
                dist = DistanceToLine(pixelPos, a, b);
                float w = cmd.param2.x;
                if (w > 1.0)
                {
                    float halfW = w * 0.5;
                    alpha = 1.0 - smoothstep(halfW - 0.5, halfW + 0.5, dist);
                }
                else
                {
                    alpha = 1.0 - smoothstep(0.5, 1.5, dist);   // Original behaviour, not a character changed
                }
                break;
            }

            case 1: // DashedLine
            {
                float2 a = cmd.param1.xy;
                float2 b = cmd.param1.zw;
                dist = DistanceToLine(pixelPos, a, b);
                
                // Simplified: use screen coordinates to decide the dash
                float lineLength = length(b - a);
                float t = clamp(dot(pixelPos - a, b - a) / max(lineLength * lineLength, 0.0001), 0.0, 1.0);
                float dashPos = t * lineLength;
                float cycle = cmd.dashLength + cmd.gapLength;
                float mod = fmod(dashPos, cycle);
                bool inDash = mod < cmd.dashLength;
                
                alpha = inDash ? 1.0 - smoothstep(0.5, 1.5, dist) : 0.0;
                break;
            }

            case 2: // Circle
            {
                float2 center = cmd.param1.xy;
                float radius = cmd.param1.z;
                float thickness = cmd.param1.w;
                dist = CircleRingSDF(pixelPos, center, radius, thickness);
                alpha = 1.0 - smoothstep(-0.5, 0.5, dist);
                break;
            }

            case 7: // Disc (filled circle: param1 = centre + radius)
            {
                float2 center = cmd.param1.xy;
                float radius = max(cmd.param1.z, 0.0);
                dist = length(pixelPos - center) - radius;
                alpha = 1.0 - smoothstep(-0.5, 0.5, dist);
                break;
            }

            case 3: // RectOutline
            {
                float2 center = cmd.param1.xy;
                float2 halfSize = cmd.param1.zw;
                float thickness = cmd.param2.x;
                dist = RectSDF(pixelPos, center, halfSize);
                // Hollow: abs(dist) - thickness
                dist = abs(dist) - thickness * 0.5;
                alpha = 1.0 - smoothstep(-0.5, 0.5, dist);
                break;
            }

            case 4: // RectFill
            {
                float2 center = cmd.param1.xy;
                float2 halfSize = cmd.param1.zw;
                dist = RectSDF(pixelPos, center, halfSize);
                alpha = dist < 0 ? 1.0 : 0.0;
                break;
            }

            case 8: // RotatedRectFill (param1 = centre + half size; param2.xy = (cos, sin))
            {
                float2 center = cmd.param1.xy;
                float2 halfSize = cmd.param1.zw;
                float2 cs = cmd.param2.xy;
                float2 d = pixelPos - center;
                // Rotate the pixel back into the rectangle's local space (by -angle), then apply the plain rectangle SDF
                float2 local = float2(d.x * cs.x + d.y * cs.y, -d.x * cs.y + d.y * cs.x);
                dist = RectSDF(local, float2(0.0, 0.0), halfSize);
                alpha = dist < 0 ? 1.0 : 0.0;
                break;
            }

            case 11: // Arc (ring arc / sector)
                     // param1 = centre + radius + thickness (when thickness <= 0 it is a sector filled from the centre out to the radius)
                     // param2.xy = start angle, end angle (degrees, 0° = +X, counter-clockwise positive; end < start sweeps clockwise)
            {
                float2 center = cmd.param1.xy;
                float radius = max(cmd.param1.z, 0.0);
                float thickness = cmd.param1.w;
                float startDeg = cmd.param2.x;
                float endDeg = cmd.param2.y;

                float2 d = pixelPos - center;
                float len = length(d);
                float aDeg = degrees(atan2(d.y, d.x));

                float sweep = endDeg - startDeg;
                float rel = aDeg - startDeg;
                // Fold the relative angle onto the side that shares the sign of the sweep direction
                rel = (sweep >= 0.0)
                    ? fmod(rel + 1440.0, 360.0)
                    : -fmod(-rel + 1440.0, 360.0);
                bool inAngle = (sweep >= 0.0) ? (rel <= sweep) : (rel >= sweep);

                // Radial: thickness > 0 makes a ring (the same maths as DrawCircle), otherwise fill from the centre outwards
                float rdist = (thickness > 0.0)
                    ? (abs(len - radius) - thickness * 0.5)
                    : (len - radius);

                alpha = inAngle ? (1.0 - smoothstep(-0.5, 0.5, rdist)) : 0.0;
                break;
            }

            case 12: // Triangle (filled triangle; the three vertices arrive counter-clockwise, the C# side guarantees the winding)
            {
                float2 t0 = cmd.param1.xy;
                float2 t1 = cmd.param1.zw;
                float2 t2 = cmd.param2.xy;
                // Signed "inward" distance of the three edges (positive inside under counter-clockwise winding) → take the min and negate it to get an SDF that is negative inside
                float2 e0 = t1 - t0, e1 = t2 - t1, e2 = t0 - t2;
                float d0 = (e0.x * (pixelPos.y - t0.y) - e0.y * (pixelPos.x - t0.x)) / max(length(e0), 1e-5);
                float d1 = (e1.x * (pixelPos.y - t1.y) - e1.y * (pixelPos.x - t1.x)) / max(length(e1), 1e-5);
                float d2 = (e2.x * (pixelPos.y - t2.y) - e2.y * (pixelPos.x - t2.x)) / max(length(e2), 1e-5);
                dist = -min(min(d0, d1), d2);
                alpha = 1.0 - smoothstep(-0.5, 0.5, dist);
                break;
            }

            case 5: // Texture
            {
                float2 targetMin = cmd.param1.xy;
                float2 targetMax = cmd.param1.zw;
                float2 uv = (pixelPos - targetMin) / max(targetMax - targetMin, 0.0001);
                
                if (uv.x >= 0 && uv.x <= 1 && uv.y >= 0 && uv.y <= 1)
                {
                    float4 texColor = _SourceTex.SampleLevel(sampler_SourceTex, uv, 0);
                    texColor *= cmdColor;
                    alpha = texColor.a;
                    cmdColor = texColor;
                }
                else
                {
                    alpha = 0.0;
                }
                break;
            }
            case 6: // Text single glyph: param1 = (x0,y0,x1,y1) target rectangle, param2 = (u0,v0,u1,v1) atlas UV
            {
                float2 tMin = cmd.param1.xy;
                float2 tMax = cmd.param1.zw;
                float2 uv = (pixelPos - tMin) / max(tMax - tMin, 0.0001);
                uv = lerp(cmd.param2.xy, cmd.param2.zw, uv);

                // Use Load (texel fetch) instead of Sample: no sampler binding is needed,
                // and it is unaffected by the atlas filterMode/wrapMode — smoothstep controls the glyph edges itself → crisper and more predictable
                uint aw, ah;
                _FontAtlas.GetDimensions(aw, ah);
                int2 texel = clamp(int2(uv * float2(aw, ah)), int2(0, 0), int2(aw - 1, ah - 1));
                float4 s = _FontAtlas.Load(int3(texel, 0));
                // _FontAtlasChannel: 0 = alpha (Alpha8 atlas), 1 = red (R8 atlas), 2 = debug (solid block, to confirm the quad placement is correct)
                float sd = (_FontAtlasChannel == 1) ? s.r : (_FontAtlasChannel == 2 ? 0.75 : s.a);

                // dashLength is reused as sharpness * 1000 (keeps the DrawCommand layout unchanged)
                float soft = max((float)cmd.dashLength, 1.0) * 0.001;
                alpha = smoothstep(0.5 - soft, 0.5 + soft, sd);
                break;
            }
        }

        // layer 3/4/5: the coverage is inverted — the command takes effect "outside" the shape
        //   3 = EraseOutside   erase everything outside the shape (clip to the shape)
        //   4 = OverOutside    normal alpha coverage outside the shape (paints outside a circle back to the background colour, with no black showing through)
        //   5 = ReplaceOutside straight overwrite outside the shape, no blending
        // Any other value (including a mistyped int) keeps plain coverage, matching the semantics from before the layer field was ever used
        if (outsideShape) alpha = 1.0 - alpha;

        // Blending. Note that finalColor accumulates **premultiplied alpha** internally (alpha is only divided back out at the very end),
        // so Erase must scale rgb together with a, otherwise repeated erasing gets brighter and brighter.
        if (alpha > 0.0)
        {
            float a = saturate(cmdColor.a * alpha);

            if (cmd.layer == 1 || cmd.layer == 3)   // Erase / EraseOutside：destination-out
            {
                finalColor *= (1.0 - a);
            }
            else if (cmd.layer == 2 || cmd.layer == 5)   // Replace / ReplaceOutside: straight overwrite, no blending
            {
                finalColor = float4(cmdColor.rgb * a, a);
            }
            else                         // Over：straight-alpha over
            {
                finalColor.rgb = cmdColor.rgb * a + finalColor.rgb * (1.0 - a);
                finalColor.a   = a              + finalColor.a   * (1.0 - a);
            }
        }
    }

    // Output straight alpha: rgb is accumulated premultiplied internally, so alpha must be divided back out for UI/Default to composite it correctly
    if (finalColor.a > 0.0001) finalColor.rgb /= finalColor.a;
    _Result[id.xy] = finalColor;
}